<!-- ================= VISITOR NAME SCRIPT ================= -->

<script>

    function welcomeVisitor() {

        const nameInput =
            document.getElementById("visitorName");

        const name =
            nameInput.value.trim();

        if (name === "") {

            alert(
                "Please enter your name."
            );

            return;
        }

        localStorage.setItem(
            "restaurantVisitorName",
            name
        );

        showWelcome(name);

    }


    function showWelcome(name) {

        document.getElementById(
            "welcomeText"
        ).innerHTML =
            "Welcome, " + name + "! 👋";


        document.getElementById(
            "nameOverlay"
        ).style.display =
            "none";

    }


    window.onload = function() {

        const savedName =
            localStorage.getItem(
                "restaurantVisitorName"
            );


        if (savedName) {

            showWelcome(savedName);

        } else {

            document.getElementById(
                "nameOverlay"
            ).style.display =
                "flex";

        }

    };

</script>


